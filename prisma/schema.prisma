generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  password  String
  role      PapelUsuario @default(USUARIO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  membros            WorkspaceMembro[]
  pessoas            Pessoa[]
  convitesEnviados   Convite[]          @relation("ConvitesEnviados")
  redefinicoesSenha  RedefinicaoSenha[]
}

/// Token de link para "esqueci minha senha", enviado por e-mail.
model RedefinicaoSenha {
  id       String    @id @default(cuid())
  token    String    @unique
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEm DateTime
  usadoEm  DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Papel do usuário no sistema como um todo (não confundir com `Role`, que é
/// o papel dele dentro de um workspace/família específico). ADMIN é reservado
/// para a equipe de contabilidade que acompanha as famílias de fora.
enum PapelUsuario {
  USUARIO
  ADMIN
}

model Workspace {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros         WorkspaceMembro[]
  pessoas         Pessoa[]
  contasFixas     ContaFixa[]
  contasVariaveis ContaVariavel[]
  metas           Meta[]
  convites        Convite[]
  configuracao    Configuracao?
}

model WorkspaceMembro {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Pessoa {
  id          String    @id @default(cuid())
  nome        String
  email       String?
  salario     Decimal   @default(0) @db.Decimal(15, 2)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  contasFixas     ContaFixa[]
  contasVariaveis ContaVariavel[]
  convites        Convite[]

  @@index([workspaceId])
  @@index([userId])
}

/// Convite de acesso ao workspace, enviado por e-mail para a pessoa cadastrada.
model Convite {
  id             String        @id @default(cuid())
  email          String
  token          String        @unique
  role           Role          @default(MEMBER)
  status         StatusConvite @default(PENDENTE)
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  convidadoPorId String?
  convidadoPor   User?         @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id], onDelete: SetNull)
  expiraEm       DateTime
  aceitoEm       DateTime?
  enviadoEm      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId])
  @@index([email])
  @@index([pessoaId])
}

enum StatusConvite {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
}

model ContaFixa {
  id          String        @id @default(cuid())
  nome        String
  valor       Decimal       @db.Decimal(15, 2)
  categoria   String        @default("Outros")
  tipo        TipoContaFixa @default(COMPARTILHADA)
  pessoaId    String?
  pessoa      Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  dataInicio  String
  dataFim     String?
  observacao  String?
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId])
  @@index([dataInicio])
}

enum TipoContaFixa {
  COMPARTILHADA
  INDIVIDUAL
}

model ContaVariavel {
  id           String    @id @default(cuid())
  nome         String
  valorTotal   Decimal   @db.Decimal(15, 2)
  valorParcela Decimal   @db.Decimal(15, 2)
  categoria    String    @default("Outros")
  pessoaId     String
  pessoa       Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  data         String
  mesInicio    String
  mesFim       String
  parcelas     Int       @default(1)
  observacao   String?
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
  @@index([mesInicio, mesFim])
}

model Meta {
  id                 String    @id @default(cuid())
  nome               String
  emoji              String    @default("🎯")
  valorAlvo          Decimal   @db.Decimal(15, 2)
  valorAtual         Decimal   @default(0) @db.Decimal(15, 2)
  contribuicaoMensal Decimal?  @db.Decimal(15, 2)
  cor                String    @default("#10b981")
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([workspaceId])
}

model Configuracao {
  id                String    @id @default(cuid())
  divisaoPorSalario Boolean   @default(false)
  /// Consentimento da família para que a contabilidade (ADMIN do sistema) veja
  /// os valores no painel contábil. Desmarcado, a família some do painel.
  compartilharComContadora Boolean @default(true)
  poeApiKey         String?
  openaiApiKey      String?
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedAt         DateTime  @updatedAt
}
