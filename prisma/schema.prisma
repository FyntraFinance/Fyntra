generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String       @id @default(cuid())
  email     String       @unique
  name      String?
  password  String
  role      PapelUsuario @default(USUARIO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  membros           WorkspaceMembro[]
  pessoas           Pessoa[]
  convitesEnviados  Convite[]          @relation("ConvitesEnviados")
  redefinicoesSenha RedefinicaoSenha[]
  inscricoesPush    InscricaoPush[]
}

/// Token de link para "esqueci minha senha", enviado por e-mail.
model RedefinicaoSenha {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiraEm  DateTime
  usadoEm   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Papel do usuário no sistema como um todo (não confundir com `Role`, que é
/// o papel dele dentro de um workspace/família específico). ADMIN é reservado
/// para a equipe de contabilidade que acompanha as famílias de fora.
enum PapelUsuario {
  USUARIO
  ADMIN
}

model Workspace {
  id        String   @id @default(cuid())
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  membros         WorkspaceMembro[]
  pessoas         Pessoa[]
  contasFixas     ContaFixa[]
  contasVariaveis ContaVariavel[]
  metas           Meta[]
  convites        Convite[]
  configuracao    Configuracao?
  eventos         Evento[]
  gastosEvento    GastoEvento[]
  ganhosExtras    GanhoExtra[]
  pagamentos      PagamentoConta[]
  aportesMeta     AporteMeta[]
  inscricoesPush  InscricaoPush[]
}

model WorkspaceMembro {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Pessoa {
  id          String    @id @default(cuid())
  nome        String
  email       String?
  salario     Decimal   @default(0) @db.Decimal(15, 2)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  contasFixas         ContaFixa[]
  contasVariaveis     ContaVariavel[]
  convites            Convite[]
  ganhosExtras        GanhoExtra[]
  participacoesEvento ParticipanteEvento[]
  aportesMeta         AporteMeta[]

  @@index([workspaceId])
  @@index([userId])
}

/// Convite de acesso ao workspace, enviado por e-mail para a pessoa cadastrada.
model Convite {
  id             String        @id @default(cuid())
  email          String
  token          String        @unique
  role           Role          @default(MEMBER)
  status         StatusConvite @default(PENDENTE)
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pessoaId       String?
  pessoa         Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  convidadoPorId String?
  convidadoPor   User?         @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id], onDelete: SetNull)
  expiraEm       DateTime
  aceitoEm       DateTime?
  enviadoEm      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workspaceId])
  @@index([email])
  @@index([pessoaId])
}

enum StatusConvite {
  PENDENTE
  ACEITO
  EXPIRADO
  CANCELADO
}

model ContaFixa {
  id            String        @id @default(cuid())
  nome          String
  valor         Decimal       @db.Decimal(15, 2)
  categoria     String        @default("Outros")
  tipo          TipoContaFixa @default(COMPARTILHADA)
  pessoaId      String?
  pessoa        Pessoa?       @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  dataInicio    String
  dataFim       String?
  /// Dia do mês em que a conta vence (1 a 31). Como a conta se repete, o
  /// vencimento é o dia, não uma data fixa.
  diaVencimento Int?
  observacao    String?
  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  pagamentos PagamentoConta[]

  @@index([workspaceId])
  @@index([dataInicio])
}

enum TipoContaFixa {
  COMPARTILHADA
  INDIVIDUAL
}

model ContaVariavel {
  id             String         @id @default(cuid())
  nome           String
  valorTotal     Decimal        @db.Decimal(15, 2)
  valorParcela   Decimal        @db.Decimal(15, 2)
  categoria      String         @default("Outros")
  pessoaId       String
  pessoa         Pessoa         @relation(fields: [pessoaId], references: [id], onDelete: Restrict)
  data           String
  mesInicio      String
  mesFim         String
  parcelas       Int            @default(1)
  /// Dia do mês em que a parcela vence (1 a 31).
  diaVencimento  Int?
  /// Como a conta foi paga. Só o cartão parcela; as outras formas quitam no
  /// próprio mês.
  formaPagamento FormaPagamento @default(CARTAO)
  observacao     String?
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Preenchido quando a conta é a cota de um gasto de evento/viagem: ela é
  /// mantida pelo próprio evento e some junto com ele.
  gastoEventoId  String?
  gastoEvento    GastoEvento?   @relation(fields: [gastoEventoId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  pagamentos PagamentoConta[]

  @@index([workspaceId])
  @@index([mesInicio, mesFim])
  @@index([gastoEventoId])
}

enum FormaPagamento {
  CARTAO
  PIX
  DINHEIRO
  BOLETO
}

model Meta {
  id                 String    @id @default(cuid())
  nome               String
  emoji              String    @default("🎯")
  valorAlvo          Decimal   @db.Decimal(15, 2)
  valorAtual         Decimal   @default(0) @db.Decimal(15, 2)
  contribuicaoMensal Decimal?  @db.Decimal(15, 2)
  cor                String    @default("#10b981")
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  aportes AporteMeta[]

  @@index([workspaceId])
}

/// Dinheiro separado para uma meta em um mês. Guardar é uma saída de caixa:
/// o valor sai da sobra daquele mês e passa a contar como já guardado.
model AporteMeta {
  id          String    @id @default(cuid())
  metaId      String
  meta        Meta      @relation(fields: [metaId], references: [id], onDelete: Cascade)
  valor       Decimal   @db.Decimal(15, 2)
  data        String
  mes         String
  /// Quem tirou o dinheiro do próprio bolso. Sem pessoa, o valor pesa na
  /// família inteira; com pessoa, entra só nos gastos dela.
  pessoaId    String?
  pessoa      Pessoa?   @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  observacao  String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workspaceId, mes])
  @@index([metaId])
}

/// Aparelho inscrito para receber avisos de vencimento. Um usuário pode ter
/// vários (celular, computador), por isso a inscrição é por endpoint.
model InscricaoPush {
  id           String    @id @default(cuid())
  endpoint     String    @unique
  p256dh       String
  auth         String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Quantos dias antes do vencimento avisar.
  diasAntes    Int       @default(3)
  /// Recado do dia sobre como anda o mês.
  resumoDiario Boolean   @default(true)
  ultimoEnvio  DateTime?
  createdAt    DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
}

model Configuracao {
  id                       String    @id @default(cuid())
  divisaoPorSalario        Boolean   @default(false)
  /// Consentimento da família para que a contabilidade (ADMIN do sistema) veja
  /// os valores no painel contábil. Desmarcado, a família some do painel.
  compartilharComContadora Boolean   @default(true)
  poeApiKey                String?
  openaiApiKey             String?
  workspaceId              String    @unique
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedAt                DateTime  @updatedAt
}

/// Viagem, festa ou qualquer ocasião em que um grupo — inclusive gente de
/// fora da família — divide as despesas em partes iguais.
model Evento {
  id          String    @id @default(cuid())
  nome        String
  emoji       String    @default("🧳")
  descricao   String?
  dataInicio  String
  dataFim     String?
  encerrado   Boolean   @default(false)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participantes ParticipanteEvento[]
  gastos        GastoEvento[]

  @@index([workspaceId])
}

/// Quem está no evento. Pode ser alguém da família (`pessoaId` preenchido, e
/// então a cota entra nos gastos dessa pessoa) ou um convidado temporário,
/// que só existe para dividir a conta.
model ParticipanteEvento {
  id        String   @id @default(cuid())
  nome      String
  eventoId  String
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  pessoaId  String?
  pessoa    Pessoa?  @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  /// Quanto esta pessoa já entregou da parte dela no evento.
  valorPago Decimal  @default(0) @db.Decimal(15, 2)
  createdAt DateTime @default(now())

  @@index([eventoId])
  @@index([pessoaId])
}

/// Despesa do evento, sempre dividida igualmente entre os participantes.
model GastoEvento {
  id          String    @id @default(cuid())
  nome        String
  valor       Decimal   @db.Decimal(15, 2)
  categoria   String    @default("Lazer")
  data        String
  observacao  String?
  eventoId    String
  evento      Evento    @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Cotas lançadas automaticamente para os participantes da família.
  cotas ContaVariavel[]

  @@index([eventoId])
  @@index([workspaceId])
}

/// Entrada avulsa de dinheiro (freela, bônus, venda) de uma pessoa em um mês.
model GanhoExtra {
  id          String    @id @default(cuid())
  nome        String
  valor       Decimal   @db.Decimal(15, 2)
  categoria   String    @default("Outros")
  pessoaId    String
  pessoa      Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
  data        String
  mes         String
  recorrente  Boolean   @default(false)
  observacao  String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, mes])
  @@index([pessoaId])
}

/// Marca de pagamento de uma conta em um mês específico. Sem registro, a
/// conta do mês está "em andamento" — só o PAGO é gravado.
model PagamentoConta {
  id              String          @id @default(cuid())
  mes             String
  status          StatusPagamento @default(PAGO)
  pagoEm          DateTime        @default(now())
  contaFixaId     String?
  contaFixa       ContaFixa?      @relation(fields: [contaFixaId], references: [id], onDelete: Cascade)
  contaVariavelId String?
  contaVariavel   ContaVariavel?  @relation(fields: [contaVariavelId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([contaFixaId, mes])
  @@unique([contaVariavelId, mes])
  @@index([workspaceId, mes])
}

enum StatusPagamento {
  EM_ANDAMENTO
  PAGO
}
