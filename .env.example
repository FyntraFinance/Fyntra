# Banco de dados Neon (copie do painel Neon → Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Segredo de assinatura das sessões (gere com: npx auth secret)
AUTH_SECRET="cole-aqui-um-segredo-de-32-bytes-em-base64"

# URL pública do site — usada nos links dos e-mails de convite.
# Em produção, use o domínio real (a Vercel também expõe VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_APP_URL="https://seu-dominio.vercel.app"

# Envio de e-mail de convite via SMTP do Gmail.
# GMAIL_APP_PASSWORD é uma "Senha de app" (16 caracteres) gerada em
# myaccount.google.com → Segurança → Verificação em duas etapas → Senhas de app.
# A senha normal da conta NÃO funciona.
GMAIL_USER="contato.fyntra@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"
